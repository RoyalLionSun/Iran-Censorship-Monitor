# Optional. Enables Cloudflare Radar HTTP traffic, outage annotations and BGP anomaly data.
# Create a Cloudflare API token with Account > Radar > Read.
CLOUDFLARE_RADAR_API_TOKEN=

# Runtime
PORT=4173
HOST=127.0.0.1

# Optional server-side cache TTL for upstream measurement requests (milliseconds).
CACHE_TTL_MS=120000
# Upstream answers kept in memory at most (expired ones are dropped first).
# FETCH_CACHE_LIMIT=1500

# Optional. Enables Internet Society Pulse curated shutdown context.
# Create a Pulse API token and keep it server-side only.
# Internet Society Pulse shutdown API. Without it a nationwide shutdown can never be
# confirmed by this dashboard; the state stays "not established" for want of access.
# Request access at https://pulse.internetsociety.org/ (API access is granted on request).
INTERNET_SOCIETY_PULSE_API_TOKEN=

# Optional. Globalping inventory works without authentication. A token raises upstream free limits.
GLOBALPING_API_TOKEN=
# Active measurements are intentionally disabled unless explicitly enabled and protected by a local operator key.
# Even then /api/globalping/measure only checks the allowed services (DNS or HTTPS HEAD) from one network registered in Iran.
GLOBALPING_ACTIVE_ENABLED=false
GLOBALPING_CONTROL_KEY=
GLOBALPING_SERVER_RUNS_PER_HOUR=10

# Optional. Outbound connections use IPv4 first; set to 1 only on hosts where IPv6 works reliably.
# MONITOR_PREFER_IPV6=1

# Optional. The server warms the default Overview on start and every few minutes; set to 0 to turn it off.
# MONITOR_PREWARM=0

# Recommended on a public server. Collects OONI measurements for Iran hourly from the OONI API
# (no raw files) into the local store (var/store): about 25-30 small requests and 18 MB of store
# per day. The dashboard then reads its own data and keeps answering while OONI limits requests.
# MONITOR_COLLECTOR=1
# Days of collected measurements to keep (default 60, about 1 GB); older periods ask OONI directly.
# STORE_RETENTION_DAYS=60

# Optional. Independent inside-out measurements (DNS answers and TLS/HTTPS handshakes towards
# public services, never page content) from RIPE Atlas and Globalping probes on networks
# registered in Iran, only towards services whose use is not punishable (see docs/DATA_RESILIENCE_PLAN.md).
# Both also need MONITOR_COLLECTOR=1; RIPE Atlas additionally needs an API key with credits.
# ACTIVE_MEASUREMENTS_ENABLED=true
# RIPE_ATLAS_API_KEY=

# Optional. Pauses single collector paths (comma-separated: ooni-api, ooni-s3, ripe-atlas,
# globalping) while the others keep running, e.g. while the OONI API blocks this address.
# MONITOR_COLLECTOR_PAUSE=ooni-api

# Not recommended for ordinary hosts. Reads OONI's public raw files for Iran (about 400 MB of
# downloads per day) into the local store; needs MONITOR_COLLECTOR=1 as well.
# OONI_S3_ENABLED=1

# New Overview answers one visitor may start per ten minutes (each costs about thirty upstream
# requests; already computed answers are unlimited). Default 40.
# OVERVIEW_NEW_PER_10_MIN=40
# Lookups a visitor can make unique (single measurements, domain drill-downs, target searches,
# routing updates) per address and ten minutes. Default 120.
# LOOKUPS_PER_10_MIN=120
# Behind exactly one reverse proxy that appends the visitor's address to X-Forwarded-For (nginx:
# proxy_add_x_forwarded_for; Caddy by default): the last entry counts, earlier ones are ignored
# because the visitor can send them. Not for chains of proxies.
# TRUST_PROXY=1

# Public address of the dashboard once it is online (e.g. https://example.org). Set it on the real
# server: the share buttons put this address in every shared link (without it they use the address
# the page was opened with, e.g. 127.0.0.1 on a test machine), and link previews on Telegram,
# WhatsApp and X need it for absolute image URLs. It also switches on HSTS when it is https. The
# feed, open data, reports and Telegram posts use it for their links (without it, this server's
# own address; never the address a visitor sent), and nothing is posted to Telegram without it.
# PUBLIC_URL=

# Change alerts: every this many minutes the all-Iran view is checked, and a nationwide outage
# beginning or ending, or a main service turning blocked or reachable across Iran, becomes a
# feed entry (and a Telegram post, if set up) once a second check confirms it. 0 turns it off.
# ALERT_CHECK_MINUTES=30

# Optional. Posts each day's "What changed" entry and change alerts to a Telegram channel. Create a bot with
# @BotFather, add it as an administrator of the channel, then set the token and the channel
# per language (e.g. @your_channel). Nothing is posted without them or without PUBLIC_URL.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHANNEL_EN=
# TELEGRAM_CHANNEL_FA=
