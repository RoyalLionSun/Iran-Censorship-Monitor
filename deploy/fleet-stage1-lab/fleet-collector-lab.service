[Unit]
Description=Iran Censorship Monitor Stage 1 collector sandbox (LAB ONLY)
ConditionPathExists=/run/iran-censorship-monitor/stage1-lab.enable

[Service]
Type=oneshot
User=iran-fleet-collector-lab
Group=iran-fleet-collector-lab
DynamicUser=yes
WorkingDirectory=/opt/iran-censorship-monitor
ExecStart=/usr/bin/node scripts/fleet-stage1-lab-egress-check.mjs collector
Environment=NODE_ENV=production
Environment=FLEET_STAGE1_LAB_ONLY=1
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectClock=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
AmbientCapabilities=
RemoveIPC=yes
UMask=0077
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
SystemCallArchitectures=native
RuntimeDirectory=iran-fleet-collector-lab
RuntimeDirectoryMode=0700
ReadWritePaths=/run/iran-fleet-collector-lab
ProtectProc=invisible
ProcSubset=pid
